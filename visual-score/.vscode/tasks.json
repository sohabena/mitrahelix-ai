{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: watch",
      "type": "shell",
      "command": "node esbuild.mjs --watch",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^✘ \\[ERROR\\] (.+)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[esbuild\\]",
          "endsPattern": "^\\[esbuild\\] (Build complete|Watching)"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Build All",
      "type": "shell",
      "command": "cd webview-ui; npm run build; cd ..; node esbuild.mjs --production",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
